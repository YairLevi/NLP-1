################################################################################
# grammar2 -- weighted CFG for Assignment 1, part A.2
#
# Extends grammar1 (A.1) so that it also generates the README sentences
# (1)-(10) and structurally similar ones, without generating sentences that
# break a verb's subcategorization frame (e.g. "*the president sighed a pickle").
# Selectional restrictions are NOT enforced: "the sandwich thought ..." is fine.
#
# File format:   <weight> <LHS> <RHS ...>   # comment
#   Weights are relative among rules that share a LHS.
#
# Naming conventions:
#   ALLCAPS      phrase-level nonterminal          (NP, VP)
#   Capitalized  preterminal / part of speech      (Noun, TransVerb)
#   lowercase    terminal word                     (sandwich)
#
# Design notes:
#   - Verbs are split into one class per subcategorization frame, so each VP
#     rule states exactly which arguments a verb takes.
#   - Single function words ("that", "is", "very", "it") appear directly in
#     rules rather than getting a one-word class; a class is introduced only
#     for open or growable word sets (nouns, verbs, conjunctions ...).
#   - Tags like "(4)(10)" point to the README sentence(s) a rule exists for.
################################################################################


#------------------------------------------------------------------------------
# Sentences
#------------------------------------------------------------------------------

1	ROOT	S .
1	ROOT	S !
1	ROOT	is it true that S ?

1	S	NP VP


#------------------------------------------------------------------------------
# Noun phrases
#   Det Noun is the only non-recursive NP with real content, so it gets the
#   highest weight; this keeps the recursive rules (PP attachment and
#   coordination) rare and the sentences short (A.1).
#------------------------------------------------------------------------------

6	NP	Det Noun		# "the president"
1	NP	ProperNoun		# (1)      proper nouns take no determiner
1	NP	it			# (5)      pronoun (expletive subject in (5))
1	NP	NP PP			# (7)      "every proposal on the desk"
0.5	NP	NP Conj NP		# (2)      "Sally and the president"

1	PP	Prep NP


#------------------------------------------------------------------------------
# Adjectives
#   Both rules recurse, producing chains like
#   "the very very perplexed fine pickle".
#------------------------------------------------------------------------------

3	Noun	Adj Noun		# adjective chains (weighted up in A.1)
1	Adj	very Adj		# (6)      degree adverb stacks on an adjective


#------------------------------------------------------------------------------
# Verb phrases -- one rule per subcategorization frame
#------------------------------------------------------------------------------

# Transitive: exactly one NP object.
2	VP	TransVerb NP		# (1)      "ate a sandwich"
1	TransVerb	TransVerb Conj TransVerb	# (2)  "wanted and ate"

# Intransitive: no object, optionally followed by a PP.
1	VP	IntransVerb		# (3)      "sighed"
1	VP	IntransVerb PP		# (7)      "worked on every proposal"

# Sentential complement: an embedded clause introduced by the
# complementizer "that".
1	VP	SentCompVerb that S	# (4)(10)  "thought that S"

# Psych verb (object experiencer) with an extraposed clausal subject:
# "it" is an expletive standing in for the "that" clause.
1	VP	PsychVerb NP that S	# (5)      "perplexed the president that S"

# Copula "is": adjective, NP, or progressive participle.
1	VP	is Adj			# (8)      "is lazy"
1	VP	is NP			# (10)     "is a sandwich"
1	VP	is PresParticiple NP	# (9)      progressive: "is eating a sandwich"


#------------------------------------------------------------------------------
# Lexicon
#------------------------------------------------------------------------------

